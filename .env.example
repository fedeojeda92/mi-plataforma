# Entorno: local | test | staging | prod
APP_ENV=local

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=plataforma
DATABASE_URL=postgresql://postgres:cambiame@localhost:5432/plataforma

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic (optional for now, needed from Misión 1)
